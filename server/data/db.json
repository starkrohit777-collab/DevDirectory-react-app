      "id": "q-4",
      "title": "Impostor syndrome as a junior: how do I ask questions without feeling stupid?",
      "body": "I am a fresher and afraid to ask \"obvious\" questions in the team chat.",
      "tags": [
        "Career",
        "Mentorship"
      ],
      "author": "Riya Sharma",
      "at": "2026-10-20T14:45:07.439Z",
      "projectId": "",
      "upvotes": [
        "Cassidy Williams",
        "Kent C. Dodds"
      ],
      "status": "Open",
      "answers": [
        {
          "id": "ans-4-0",
          "author": "Sarah Drasner",
          "body": "Share what you already tried when you ask. That turns it into a good question and people respond happily. Also write the answer into docs — you help the next person too.",
          "at": "2026-10-20T15:45:07.439Z",
          "votes": [],
          "accepted": false
        }
      ]
    }
