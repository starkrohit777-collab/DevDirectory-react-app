        {
          "id": "th-2",
          "kind": "Decision",
          "title": "Should we use CSS variables or a JS theme object for tokens?",
          "body": "CSS variables work without a runtime and allow theming on any DOM subtree. A JS object gives type safety. Proposal: CSS variables + generated TypeScript types.",
          "author": "Lee Robinson",
          "at": "2026-10-15T14:45:07.437Z",
          "pinned": false,
          "upvotes": [
            "Sarah Drasner",
            "Kent C. Dodds",
            "Dan Abramov"
          ],
          "replies": [
            {
              "id": "r-2-0",
              "author": "Sarah Drasner",
              "body": "Agree. Generated types give us the best of both.",
              "at": "2026-10-15T11:45:07.437Z"
            },
            {
              "id": "r-2-1",
              "author": "Kent C. Dodds",
              "body": "+1, and it keeps the bundle smaller.",
              "at": "2026-10-15T09:45:07.437Z"
            }
          ]
        },
        {
