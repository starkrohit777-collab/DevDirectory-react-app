  "problems": [
    {
      "id": "q-1",
      "title": "Burnout in small teams: how do you keep a sustainable pace?",
      "body": "Our 4-person team keeps committing to aggressive sprints. We are tired and quality is dropping. What practices actually worked for you?",
      "tags": [
        "Team health",
        "Process"
      ],
      "author": "Cassidy Williams",
      "at": "2026-10-17T14:45:07.438Z",
      "projectId": "",
      "upvotes": [
        "Dan Abramov",
        "Kent C. Dodds",
        "Sarah Drasner"
      ],
      "status": "Open",
      "answers": [
        {
          "id": "ans-1-0",
          "author": "Kent C. Dodds",
          "body": "Commit to less. Plan to 70% capacity, keep a buffer for bugs, and have a \"no new work mid-sprint\" rule. Track cycle time, not hours.",
          "at": "2026-10-17T17:45:07.439Z",
          "votes": [],
          "accepted": false
        }
      ]
    },
    {
      "id": "q-2",
      "title": "Legacy jQuery app: rewrite or migrate gradually?",
      "body": "We maintain a 10-year-old jQuery app with no tests. Management wants a full React rewrite. Is that wise?",
      "tags": [
        "Legacy",
        "Architecture"
      ],
      "author": "Lee Robinson",
      "at": "2026-10-12T14:45:07.439Z",
      "projectId": "p-ui-kit",
      "upvotes": [
        "Dan Abramov",
        "Theo Browne"
      ],
      "status": "Solved",
      "answers": [
        {
          "id": "ans-2-0",
          "author": "Dan Abramov",
          "body": "Avoid the big-bang rewrite. Wrap pages one at a time (strangler pattern), add characterization tests first, and ship each slice to production.",
          "at": "2026-10-12T19:45:07.439Z",
          "votes": [],
          "accepted": true
        },
        {
          "id": "ans-2-1",
          "author": "Theo Browne",
          "body": "Agree. Start with the highest-churn pages — that is where you recover the investment fastest.",
          "at": "2026-10-12T21:45:07.439Z",
          "votes": [],
          "accepted": false
        }
      ]
    },
